    {
      "cell_type": "code",
      "source": [
        "def median_filter(image):\n",
        "    image = image.convert(\"L\")\n",
        "    output = image.copy()\n",
        "\n",
        "    for x in range(1, image.width - 1):\n",
        "        for y in range(1, image.height - 1):\n",
        "\n",
        "            pixels = []\n",
        "\n",
        "            for i in range(-1, 2):\n",
        "                for j in range(-1, 2):\n",
        "                    pixels.append(\n",
        "                        image.getpixel((x + i, y + j))\n",
        "                    )\n",
        "\n",
        "            pixels.sort()\n",
        "            median = pixels[4]\n",
        "\n",
        "            output.putpixel((x, y), median)\n",
        "\n",
        "    return output"
      ],
