        "**Gamma Transformation**\n",
        "\n",
        "\n",
        "\n",
        "digunakan untuk meningkatkan intensitas pixel yang gelap menjadi terang"
      ],
      "metadata": {
        "id": "fSYVA3F-HHLO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def gamma_transform(image, gamma):\n",
        "    image = image.convert(\"L\")\n",
        "    output = Image.new(\"L\", image.size)\n",
        "\n",
        "    for x in range(image.width):\n",
        "        for y in range(image.height):\n",
        "            r = image.getpixel((x, y)) / 255\n",
        "            s = 255 * (r ** gamma)\n",
        "\n",
        "            output.putpixel((x, y), int(s))\n",
        "\n",
        "    return output"
      ],
      "metadata": {
        "id": "kqiW_BC_HfKx"
      },
      "execution_count": 35,
      "outputs": []
